rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Who may touch the data ──────────────────────────────────────────
    // Usernames in this system are NOT real mailboxes, so nothing here relies
    // on email. A request is accepted only when:
    //   1. it comes from a Firebase Auth email/password sign-in (never anonymous),
    //   2. auth_users/{uid} maps that Firebase user to a username — only an
    //      admin can write that mapping, so a self-registered account is useless,
    //   3. authorized_users/{username} exists and is not switched off.
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function mapPath() { return /databases/$(database)/documents/auth_users/$(request.auth.uid); }
    function username() { return get(mapPath()).data.username; }
    function userPath() { return /databases/$(database)/documents/authorized_users/$(username()); }
    function userData() { return get(userPath()).data; }
    function isAuthorized() {
      return signedIn() && exists(mapPath()) && exists(userPath()) && userData().active != false;
    }
    function roleId() {
      return userData().roleId != null ? userData().roleId : userData().role;
    }
    function isAdmin() {
      return isAuthorized() && (roleId() == 'admin' || userData().role == 'admin');
    }
    // The "sales" role is read-only (it sees the pipeline and performance).
    function canWrite() { return isAuthorized() && roleId() != 'sales'; }

    // ── Login ↔ user mapping and the user records ───────────────────────
    match /auth_users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }
    match /authorized_users/{name} {
      allow read: if isAuthorized() && (username() == name || isAdmin());
      // A user may only flip their own "must change password" flag.
      allow update: if isAdmin()
        || (isAuthorized() && username() == name
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'passwordChangedAt']));
      allow create, delete: if isAdmin();
    }

    // ── Admin-only configuration ────────────────────────────────────────
    match /security_roles/{id}    { allow read: if isAuthorized(); allow write: if isAdmin(); }
    match /approval_policies/{id} { allow read: if isAuthorized(); allow write: if isAdmin(); }
    match /company_branches/{id}  { allow read: if isAuthorized(); allow write: if isAdmin(); }
    match /settings/{id}          { allow read: if isAuthorized(); allow write: if isAdmin(); }

    // ── Append-only logs ────────────────────────────────────────────────
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isAuthorized();
      allow update, delete: if false;
    }
    match /deal_stage_changes/{id} {
      allow read: if isAuthorized();
      allow create: if canWrite();
      allow update, delete: if false;
    }

    // ── Everything else (ledger, deals, invoices, counters, attachments…) ──
    match /user_presence/{id} { allow read, write: if isAuthorized(); }
    match /{document=**} {
      allow read: if isAuthorized();
      allow write: if canWrite();
    }
  }
}
